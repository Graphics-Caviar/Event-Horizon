{
	"dependencies": {
		"@dimforge/rapier3d-compat": "^0.20.0",
		"firebase": "^10.14.1",
		"three": "^0.160.0"
	},
	"description": "Event Horizon: Escape from Singularity - 3D browser action game with Three.js and Firebase backend",
	"devDependencies": {
