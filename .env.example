# Firebase Configuration for Event Horizon
# Get these keys from Firebase Console -> Project Settings -> General
#   -> Your Apps -> SDK setup and configuration

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Optional. Only used for Google Analytics; the game works without it.
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Set to true to point the game and `npm run seed` at the local Firebase
# Emulator Suite (firebase emulators:start) instead of the live project.
# Ports come from firebase.json: auth 9099, firestore 8080.
VITE_FIREBASE_USE_EMULATOR=false
